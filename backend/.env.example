# ── Server ─────────────────────────────────────────────
PORT=4000
# This should be wherever your FRONTEND runs — used inside QR codes
BASE_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────
# For local MongoDB on your own computer:
MONGO_URI=mongodb://localhost:27017/kistet-ar-menu
# For MongoDB Atlas (cloud), replace with your Atlas connection string instead, e.g.:
# MONGO_URI=mongodb+srv://youruser:yourpass@cluster0.xxxxx.mongodb.net/kistet-ar-menu?retryWrites=true&w=majority

# ── Security ───────────────────────────────────────────
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES=30d

# ── Cloudinary (file storage for photos and 3D models) ─────────────────
CLOUDINARY_CLOUD_NAME=vlarq8yr
CLOUDINARY_API_KEY=918655267222462
CLOUDINARY_API_SECRET=your-api-secret-here
