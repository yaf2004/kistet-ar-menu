# Server
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/kistet-ar-menu

# Security: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-48-random-bytes-in-hex
JWT_EXPIRES=12h
JWT_ISSUER=kistet-ar-menu
JWT_AUDIENCE=kistet-ar-menu-web

# Exact frontend origins, comma-separated. Example:
ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
